# Traefik Static Configuration
# https://doc.traefik.io/traefik/
#
# No edits required - just copy to traefik.yml

global:
  checkNewVersion: true
  sendAnonymousUsage: false

# API and Dashboard
api:
  dashboard: true
  insecure: false

# Entry Points
entryPoints:
  web:
    address: ":80"

  websecure:
    address: ":443"
    http:
      tls: {}
    # Self-signed cert — browser warnings expected for .mediastack.lab domains
    # Cloudflare Tunnel handles proper SSL for external access

# Providers
providers:
  docker:
    endpoint: "unix:///var/run/docker.sock"
    exposedByDefault: false
    network: arr-stack
    watch: true

  file:
    directory: /dynamic
    watch: true

# Logging
log:
  level: INFO
  filePath: /var/log/traefik/traefik.log
  format: common

# Access Logs
accessLog:
  filePath: /var/log/traefik/access.log
  format: common
  bufferingSize: 100

# Ping for healthcheck
ping:
  entryPoint: web
